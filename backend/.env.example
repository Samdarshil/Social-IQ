# Copy to .env (git-ignored). Everything is optional: demo mode works with none of these.
SOCIALIQ_ENV=development
JWT_SECRET=
TOKEN_ENCRYPTION_KEY=          # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
DATABASE_URL=sqlite:///./data/socialiq.db   # or postgresql+psycopg://user:pass@host/db
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
# --- AI assistant (Google Gemini). Leave GEMINI_API_KEY empty to use the built-in rule-based router.
GEMINI_API_KEY=                # create one at https://aistudio.google.com/apikey  (server-side only; never exposed to the frontend)
GEMINI_MODEL=gemini-3.8-flash  # any Gemini model that supports function calling
LLM_TIMEOUT_SECONDS=20         # per Gemini request
LLM_TOTAL_BUDGET_SECONDS=45    # whole question including tool rounds, then fall back to the rule-based router
# GEMINI_BASE_URL=             # optional: proxy or local test server
GOOGLE_CLIENT_ID=              # YouTube (scope: youtube.readonly)
GOOGLE_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
X_CLIENT_ID=
X_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- YouTube trending clustering (optional). Without CSVs the app serves committed snapshots.
# YT_TRENDING_DIR=              # folder holding USvideos.csv etc. (default backend/data/kaggle_youtube)
